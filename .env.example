DISCORD_TOKEN=
GOOGLE_GENERATIVE_AI_API_KEY=
TWITCH_BOT_USERNAME=
TWITCH_OAUTH_TOKEN=
TWITCH_CHANNEL=
EFT_API_KEY=
STEAM_API_KEY=
CSGOSKINS_API_KEY=
CSFLOAT_API_KEY=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DASHBOARD_OAUTH_REDIRECT_URI=
DASHBOARD_ALLOWED_USER_IDS=
DASHBOARD_ALLOW_GUILD_ADMINS=false
DASHBOARD_HOST=127.0.0.1

# AI model (change + restart to switch; fully reversible)
# gemini-3.1-flash-lite = newer + cheapest. Alternatives:
#   gemini-2.5-flash, gemini-3-flash-preview, gemini-3.8-flash
AI_PRIMARY_MODEL=gemini-3.1-flash-lite
AI_FALLBACK_MODEL=gemini-2.5-flash
# Optional: force a timezone for the bot's date/time awareness (defaults to server TZ)
# BOT_TIMEZONE=America/New_York

# DM control channel (see SETUP.md). Empty allowlist disables it entirely.
DM_ALLOWLIST=
OPENCODE_SERVER_URL=http://127.0.0.1:4096
OPENCODE_SERVER_PASSWORD=
DM_AGENT_MODEL=opencode-go/deepseek-v4.1-flash
DM_AGENT_DIR=
# DM_AGENT_TIMEOUT_MS=600000
