DISCORD_TOKEN=
GOOGLE_GENERATIVE_AI_API_KEY=
TWITCH_BOT_USERNAME=
TWITCH_OAUTH_TOKEN=
TWITCH_CHANNEL=
EFT_API_KEY=
STEAM_API_KEY=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DASHBOARD_OAUTH_REDIRECT_URI=
DASHBOARD_ALLOWED_USER_IDS=
DASHBOARD_ALLOW_GUILD_ADMINS=false
DASHBOARD_HOST=127.0.0.1

# AI model (change + restart to switch; fully reversible)
# Cloudflare Workers AI models for chat and photos. Must be on the free plan.
AI_PRIMARY_MODEL=@cf/meta/llama-4-scout-17b-16e-instruct
AI_FALLBACK_MODEL=@cf/google/gemma-4-26b-a4b-it
# Optional: force a timezone for the bot's date/time awareness (defaults to server TZ)
# BOT_TIMEZONE=America/New_York

# DM control channel (see SETUP.md). Empty allowlist disables it entirely.
DM_ALLOWLIST=
OPENCODE_SERVER_URL=http://127.0.0.1:4096
OPENCODE_SERVER_PASSWORD=
DM_AGENT_MODEL=opencode-go/deepseek-v4.1-flash
DM_AGENT_DIR=
# DM_AGENT_TIMEOUT_MS=600000

# Cloudflare Workers AI: chat, photos and image generation
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
