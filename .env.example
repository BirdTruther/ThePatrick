DISCORD_TOKEN=
GOOGLE_GENERATIVE_AI_API_KEY=
TWITCH_BOT_USERNAME=
TWITCH_OAUTH_TOKEN=
TWITCH_CHANNEL=
EFT_API_KEY=
STEAM_API_KEY=
CSGOSKINS_API_KEY=
CSFLOAT_API_KEY=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DASHBOARD_OAUTH_REDIRECT_URI=
DASHBOARD_ALLOWED_USER_IDS=
DASHBOARD_ALLOW_GUILD_ADMINS=false
DASHBOARD_HOST=127.0.0.1

# AI model (change + restart to switch; fully reversible)
# provider/model, served through OPENCODE_CHAT_URL. Pictures go to the fallback.
AI_PRIMARY_MODEL=opencode-go/beam-free
AI_FALLBACK_MODEL=opencode-go/deepseek-v4.1-flash
OPENCODE_CHAT_URL=http://127.0.0.1:4097
OPENCODE_CHAT_PASSWORD=
OPENCODE_CHAT_DIR=
# Optional: force a timezone for the bot's date/time awareness (defaults to server TZ)
# BOT_TIMEZONE=America/New_York

# DM control channel (see SETUP.md). Empty allowlist disables it entirely.
DM_ALLOWLIST=
OPENCODE_SERVER_URL=http://127.0.0.1:4096
OPENCODE_SERVER_PASSWORD=
DM_AGENT_MODEL=opencode-go/deepseek-v4.1-flash
DM_AGENT_DIR=
# DM_AGENT_TIMEOUT_MS=600000
